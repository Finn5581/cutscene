# Copy to .env.local for local dev. On Railway, set these as service variables.

# Public URL of the site (used in links inside texts/emails). No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000
# SQLite file. On Railway, mount a volume at /data and use /data/app.db
DB_PATH=./data/app.db

# Admin page
ADMIN_PASSWORD=change-me
# Long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Twilio (SMS). Use either a Messaging Service SID (recommended) or a From number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Resend (email). RESEND_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Slot Alerts <alerts@yourdomain.com>"

# Owner alerts: SMS to this number and/or Telegram
ADMIN_PHONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional tuning (defaults shown)
# WAITWHILE_LOCATION=chromeheartsmiami
# LOCATION_LABEL=Chrome Hearts Miami
# LOCATION_TIMEZONE=America/New_York
# TARGET_SERVICE_IDS=            # e.g. WHmjBONC1Mcf8VSqjWar (In-store shopping); empty = any service
# MIN_NOTICE_MINUTES=15
# MAX_NOTICE_DAYS=5
# OPEN_HOUR=11
# CLOSE_HOUR=19
# POLL_MIN_SECONDS=20
# POLL_MAX_SECONDS=30
# MAX_BACKOFF_SECONDS=900
# MAX_ALERTS_PER_PERSON_PER_DAY=5
# BOOKED_PAUSE_DAYS=14
# STALE_AFTER_SECONDS=300
# ADMIN_ALERT_COOLDOWN_MINUTES=30
